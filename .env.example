ENV=development
DATABASE_URL=sqlite:///./genpay.db
SECRET_KEY=change-me
WEBHOOK_SIGNING_SECRET=change-me
INTERNAL_API_KEY=change-me
# Key for the mcp-agent client the MCP server (mcp_server/) uses; must differ from INTERNAL_API_KEY.
MCP_AGENT_API_KEY=change-me-mcp

# Revenue split, in basis points (1% = 100 bps); must sum to 10000.
ARCHIVE_SHARE_BPS=7000
TRANSCRIPTIONIST_SHARE_BPS=2000
PLATFORM_SHARE_BPS=1000
